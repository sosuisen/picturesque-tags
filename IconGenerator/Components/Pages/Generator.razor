@page "/generator"
@rendermode InteractiveServer

@using Svg
@using Svg.Pathing
@using System.Drawing
@using SvgGenerator

<PageTitle>Icon Generator</PageTitle>

<h1>Icon Generator</h1>

<button class="btn btn-primary" @onclick="Generate">Generate icon</button>

<div>
    @foreach (var icon in iconList)
    {
        <div style="width: @(width)px; height: @(height)px; float: left; ">
            @((MarkupString)icon)
        </div>
    }
</div>

@code {
    private List<string> iconList = [];
    private int width = 256;
    private int height = 256;

    private void Generate()
    {
        string[] tags = new string[] { 
            "apple", "banana", "cherry", "date", "elderberry", "fig", "grape", "honeydew", "kiwi", "lemon", "mango", "nectarine", "orange", "pear", "quince", "raspberry", "strawberry", "tangerine", "ugli", "vanilla", "watermelon", "xigua", "yuzu", "zucchini"  
            };
        foreach (var tag in tags) {
            iconList.Add(GenerateIcon(tag));
        }
    }

    private string GenerateIcon(string tag)
    {
        var builder = new IconBuilder(width, height);
        
        return builder.addBackground(HatchPattern.GenerateHatchPatternFromText(tag))
            .addForeground()
            .toSvg();
    }
}