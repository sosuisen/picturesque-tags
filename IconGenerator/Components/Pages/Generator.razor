@page "/generator"
@rendermode InteractiveServer

@using Svg
@using Svg.Pathing
@using System.Drawing
@using SvgGenerator

<PageTitle>PicturesqueTags</PageTitle>

<h1>PicturesqueTags</h1>

<button class="btn btn-primary" @onclick="Generate">Generate icon</button>

<div style="margin-top:10px;">
    @foreach (var icon in iconList)
    {
        <div style="width: @(width)px; height: @(height)px; float: left; ">
            @((MarkupString)icon)
        </div>
    }
</div>

@code {
    private List<string> iconList = [];

    private int width = 256;
    private int height = 256;
/*
    private int width = 128;
    private int height = 128;
*/
    private void Generate()
    {
  /*
        var cardList = new CardList();
        foreach (var card in cardList.List)
        {
            iconList.Add(GenerateIcon(card.Tags));
        }
  */

        string[] tags = new string[] {
        "apple", "banana", "cherry", "date", "elderberry", "fig", "grape", "honeydew", "kiwi", "lemon", "mango", "nectarine",
        "orange", "pear", "quince", "raspberry", "strawberry", "tangerine", "ugli", "vanilla", "watermelon", "xigua", "yuzu",
        "zucchini",
        "Avocado", "Blackberry", "Cantaloupe", "Dragonfruit", "Eggplant", "Figs", "Grapes", "Honeydew", "Iceberg", "Jicama",    
        "Kiwi", "Lemon", "Mango", "Nectarine", "Orange", "Peach", "Quince", "Raspberry", "Strawberry", "Tangerine", "Ugli", 
        "Vanilla", "Watermelon", "Xigua", "Yuzu", "Zucchini",
        };        
        foreach (var tag in tags)
        {
            iconList.Add(GenerateIcon(tag));
        }

    }

    private string GenerateIcon(string tag)
    {
        var builder = new IconBuilder(width, height);
        return builder.generateBgFromText(tag)
//        .addForeground()
        .toSvg();
    }

    private string GenerateIcon(List<string> tags)
    {
        if (tags.Count > 0)
        {
            return GenerateIcon(tags[0]);
        }
        else
        {
            var builder = new IconBuilder(width, height);            
            return builder.Default().toSvg();
        }
    }
}